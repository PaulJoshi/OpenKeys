{
  "name": "openkeys",
  "private": true,
  "version": "0.1.0",
  "description": "Free, open-source piano teacher in the browser: listens through your mic or MIDI keyboard. A free alternative to Yousician, Synthesia, Simply Piano and flowkey.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "samples": "node scripts/copy-samples.mjs",
    "predev": "node scripts/copy-samples.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-samples.mjs",
    "build": "tsc -b && vite build && node scripts/build-site.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "accuracy": "ACCURACY=1 vitest run tests/accuracy/accuracy.test.ts --testTimeout=1800000"
  },
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1",
    "@tonejs/midi": "^2.0.28",
    "abcjs": "^6.7.1",
    "dexie": "^4.4.6",
    "jszip": "^3.10.2",
    "opensheetmusicdisplay": "^2.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tone": "^15.1.22",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@audio-samples/piano-mp3-velocity12": "^1.0.5",
    "@audio-samples/piano-mp3-velocity16": "^1.0.5",
    "@audio-samples/piano-mp3-velocity4": "^1.0.5",
    "@audio-samples/piano-mp3-velocity8": "^1.0.5",
    "@playwright/test": "1.56",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
