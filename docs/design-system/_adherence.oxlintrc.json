{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badges/**",
              "components/buttons/**",
              "components/cards/**",
              "components/core/**",
              "components/disclosure/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/app/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bebas Neue|Inter))/i]",
        "message": "Font not provided by the design system. Available: Bebas Neue, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|style|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:promo|error|success|muted)$/]",
        "message": "<Badge> variant must be one of 'promo' | 'error' | 'success' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BenefitCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|cta|onCta|image|background|height|children|style|key|ref|className|style|children)$/]",
        "message": "<BenefitCard> doesn't accept that prop. Declared props: title, cta, onCta, image, background, height, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|fullWidth|disabled|type|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, fullWidth, disabled, type, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|onImage)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'onImage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|tone|image|background|cta|onCta|height|displaySize|children|style|key|ref|className|style|children)$/]",
        "message": "<CampaignTile> doesn't accept that prop. Declared props: headline, tone, image, background, cta, onCta, height, displaySize, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<CampaignTile> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryIconCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CategoryIconCard> doesn't accept that prop. Declared props: icon, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclosureRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|variant|defaultOpen|open|onToggle|children|style|key|ref|className|style|children)$/]",
        "message": "<DisclosureRow> doesn't accept that prop. Declared props: title, variant, defaultOpen, open, onToggle, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclosureRow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:detail|faq)$/]",
        "message": "<DisclosureRow> variant must be one of 'detail' | 'faq'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|count|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: active, count, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterSidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:groups|onToggle|width|style|key|ref|className|style|children)$/]",
        "message": "<FilterSidebar> doesn't accept that prop. Declared props: groups, onToggle, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|legal|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: columns, legal, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|iconSize|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, iconSize, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|ghost|onImage|inverse)$/]",
        "message": "<IconButton> variant must be one of 'soft' | 'ghost' | 'onImage' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PianoKeyboard'] > JSXAttribute > JSXIdentifier[name!=/^(?:startOctave|octaves|keyStates|showLabels|height|onKeyPress|style|key|ref|className|style|children)$/]",
        "message": "<PianoKeyboard> doesn't accept that prop. Declared props: startOctave, octaves, keyStates, showLabels, height, onKeyPress, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PianoKeyboard'] > JSXAttribute[name.name='showLabels'] > Literal[value!=/^(?:c|all|none)$/]",
        "message": "<PianoKeyboard> showLabels must be one of 'c' | 'all' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrimaryNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|active|onNavigate|right|height|style|key|ref|className|style|children)$/]",
        "message": "<PrimaryNav> doesn't accept that prop. Declared props: brand, links, active, onNavigate, right, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|defaultValue|onChange|onSubmit|width|autoFocus|style|key|ref|className|style|children)$/]",
        "message": "<SearchPill> doesn't accept that prop. Declared props: placeholder, value, defaultValue, onChange, onSubmit, width, autoFocus, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SongCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|meta|metaVariant|badge|swatches|image|media|aspectRatio|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SongCard> doesn't accept that prop. Declared props: title, subtitle, meta, metaVariant, badge, swatches, image, media, aspectRatio, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SongCard'] > JSXAttribute[name.name='metaVariant'] > Literal[value!=/^(?:success|error|muted)$/]",
        "message": "<SongCard> metaVariant must be one of 'success' | 'error' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:breadcrumb|title|filtersHidden|onToggleFilters|sortLabel|onSort|style|key|ref|className|style|children)$/]",
        "message": "<SubNav> doesn't accept that prop. Declared props: breadcrumb, title, filtersHidden, onToggleFilters, sortLabel, onSort, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwatchDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|active|size|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SwatchDot> doesn't accept that prop. Declared props: color, active, size, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UtilityBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|links|style|key|ref|className|style|children)$/]",
        "message": "<UtilityBar> doesn't accept that prop. Declared props: left, links, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
